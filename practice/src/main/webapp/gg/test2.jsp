<%@ page contentType="text/html; charset=utf-8" %>

<%
    String[] questions = {
        // 위의 질문 20개 입력
    		"가까운 거리는 자동차 대신 걷거나 자전거를 이용한다.",
		"대중교통을 적극적으로 이용하려고 노력한다.",
    		"이동할 때 불필요한 자동차 이용을 줄인다.",
		"보행자와 자전거 이용자의 안전을 고려하며 이동한다.",
		"대중교통 이용이 편리한 이동 경로를 선택한다.",
		"사용하지 않는 전등과 전자기기의 전원을 끈다.",
		"물을 낭비하지 않도록 생활 속에서 절약한다.",
		"쓰레기를 종류에 맞게 분리배출한다.",
		"일회용품 사용을 줄이고 다회용품을 이용한다.",
		"재사용할 수 있는 물건은 버리지 않고 다시 활용한다.",
		"집 안의 환기와 청결을 꾸준히 관리한다.",
		"화재나 재난에 대비한 안전 수칙을 확인한다.",
		"주거 공간에서 발생하는 소음과 생활 불편을 줄이려고 노력한다.",
		"공용 공간을 깨끗하고 안전하게 사용한다.",
		"주거 환경의 위험 요소나 불편 사항을 발견하면 개선을 요청한다.",
		"우리 동네의 환경 문제와 지역 소식에 관심을 가진다.",
		"지역의 공원과 공공시설을 깨끗하게 이용한다.",
		"지역 환경 개선 활동이나 봉사활동에 참여한다.",
		"이웃과 서로 배려하고 공동체 생활 규칙을 지킨다.",
		"우리 지역의 주거 환경과 도시 문제에 대한 의견을 표현한다."
    };

    String[] choices = {
        "전혀 실천하지 않는다",
        "가끔 실천한다",
        "자주 실천한다",
        "항상 실천한다"
    };
%>

<html>
<head>
    <title>나의 환경 실천 수준 평가</title>
    <link rel="stylesheet" href="test.css">
</head>
<body>

    <h2>나의 환경 실천 수준 평가</h2>

    <form method="post" action="score2.jsp">

        <!-- 이곳에 반복문 작성 -->
	        <%
            for(int i = 0; i < questions.length; i++) {
        %>

            <p><%= (i + 1) %>. <%= questions[i] %></p>

            <%
            for(int j = 0; j < choices.length; j++) {
            %>

                <label>
                    <input type="radio"
                           name="p<%= i + 1 %>"
                           value="<%= j + 1 %>"
                           required>
                    <%= (j + 1) %>. <%= choices[j] %>
                </label>
                <br>

            <%
                }
            %>

        <%
            }
        %>
        <input type="submit" value="제출하기">

    </form>

</body>
</html>